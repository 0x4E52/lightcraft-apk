<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the Android manifest. `cargo xtask android manifest` fills the placeholders
  (xtask/src/android/manifest.rs); nothing here is edited by hand per build.
  Permissions arrive with the features that need them (docs/android-port.md: APK-21, APK-22).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="${APPLICATION_ID}"
    android:versionCode="${VERSION_CODE}"
    android:versionName="${VERSION_NAME}">

    <uses-sdk
        android:minSdkVersion="${MIN_SDK}"
        android:targetSdkVersion="${TARGET_SDK}" />

    <!-- INTERNET: model downloads (crates/fetch) and the debug control server on loopback, which is
         off unless `debug.lightcraft.control` is set and then needs a token (docs/android.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The photo library (APK-22, crates/android-sys/src/permissions.rs asks for them at run time):
         READ_MEDIA_IMAGES from API 33, READ_MEDIA_VISUAL_USER_SELECTED (partial access) from 34,
         READ_EXTERNAL_STORAGE on 30-32 only. ACCESS_MEDIA_LOCATION keeps the GPS in EXIF read
         through the shared storage, which Android otherwise blanks. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- hasCode=false: the app is pure Rust through NativeActivity, no Java classes.
         allowBackup=false: Auto Backup would copy the catalog to Drive.
         extractNativeLibs=false: the stored, 16 KB-aligned library is mapped in place.
         enableOnBackInvokedCallback=false, always: Back reaches native code only as KEYCODE_BACK,
         which targetSdk 36 stops dispatching without this opt-out. -->
    <application
        android:label="${APP_LABEL}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender">
            <meta-data
                android:name="android.app.lib_name"
                android:value="lightcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with LightCraft" (APK-25, crates/android-host/src/incoming.rs): photos and raws; the URI is the data. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="image/x-adobe-dng" />
                <data android:mimeType="image/x-canon-cr2" />
                <data android:mimeType="image/x-canon-cr3" />
                <data android:mimeType="image/x-nikon-nef" />
                <data android:mimeType="image/x-sony-arw" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Share one file: photos are imported; presets (zip, xmp), track logs (gpx), keyword lists (text) and
                 other files land in the Inbox. The URI is EXTRA_STREAM. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="image/x-adobe-dng" />
                <data android:mimeType="image/x-canon-cr2" />
                <data android:mimeType="image/x-canon-cr3" />
                <data android:mimeType="image/x-nikon-nef" />
                <data android:mimeType="image/x-sony-arw" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/rdf+xml" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share several: as SEND, the URIs are the EXTRA_STREAM list. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="image/x-adobe-dng" />
                <data android:mimeType="image/x-canon-cr2" />
                <data android:mimeType="image/x-canon-cr3" />
                <data android:mimeType="image/x-nikon-nef" />
                <data android:mimeType="image/x-sony-arw" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/rdf+xml" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- A camera plugged in by USB (APK-59, crates/android-sys/src/usb.rs): Android offers
                 LightCraft for the devices res/xml/device_filter.xml lists (PTP / MTP cameras), and
                 its device scan lists the camera under File > Import from Device. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
